# Build stage
FROM node:20-alpine AS builder

WORKDIR /app

# Copy package files
COPY frontend/package*.json ./

# Install dependencies
RUN npm ci

# Copy source code
COPY frontend/ ./

# Build-time env for Vite (baked into static assets)
ARG VITE_API_URL=/api
ARG VITE_TOURNAMENT_API_URL=http://141.37.123.132:8086
ARG VITE_REALTIME_WS_URL=
ARG VITE_MATCH_RUNNER_URL=/match-runner
ENV VITE_API_URL=$VITE_API_URL
ENV VITE_TOURNAMENT_API_URL=$VITE_TOURNAMENT_API_URL
ENV VITE_REALTIME_WS_URL=$VITE_REALTIME_WS_URL
ENV VITE_MATCH_RUNNER_URL=$VITE_MATCH_RUNNER_URL

# Build the application
RUN npm run build

# Production stage
FROM nginx:alpine

# Copy built assets from builder
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy nginx configuration
COPY frontend/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
